# The kit's own code uses tabs. Files under template/ keep their own style: generated projects format them with Biome.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[template/**]
indent_style = unset
indent_size = unset
