		"typescript": "6",
		"@biomejs/biome": "2",
		"knip": "6",
		"hono": "4",
		"@hono/zod-validator": "0.9",
		"zod": "4",
		"drizzle-orm": "0.45",
		"drizzle-kit": "0.31",
		"pg": "8",
		"@electric-sql/pglite": "0.5",
		"sql.js": "1",
		"better-auth": "1",
		"resend": "6",
		"react-email": "6",
		"@react-email/ui": "6",
		"wrangler": "4",
		"@cloudflare/vite-plugin": "1",
		"nitro": "3",
		"vite-plugin-svgr": "5",
		"shadcn": "4",
		"@playwright/cli": "0.1",
		"@tanstack/intent": "0.5",
		"@vercel/functions": "3",
		"next": "16",
		"@opennextjs/cloudflare": "1",
		"@hono/vercel": "1",
		"@svgr/webpack": "8",
		"@vitejs/plugin-react": "6"
	},
	"holdBack": {},
	"scaffoldLines": { "@types/node": "22" },
	"pnpmAllowBuilds": ["esbuild"],
