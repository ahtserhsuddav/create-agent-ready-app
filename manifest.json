	"scripts": {
		"core": {
			"check": "{{run}} typecheck && {{run}} lint && {{run}} unused && {{run}} test && {{run}} scope",
			"lint": "biome check .",
			"fix": "biome check --write .",
			"unused": "knip",
			"scope": "{{script}} scripts/agent/scope.ts",
			"log": "{{script}} scripts/agent/log.ts",
			"task:new": "{{script}} scripts/agent/task-new.ts",
			"new:feature": "{{script}} scripts/agent/new-feature.ts",
			"docs:sync": "{{script}} scripts/agent/docs-sync.ts",
			"docs:get": "{{script}} scripts/agent/docs-get.ts",
			"design:md": "{{script}} scripts/agent/design-md.ts",
			"release:check": "{{script}} scripts/agent/release-check.ts",
			"prepare": "{{script}} scripts/agent/link-skills-and-hooks.ts",
			"kit:update": "{{dlx}} create-agent-ready-app@latest update .",
			"kit:doctor": "{{dlx}} create-agent-ready-app@latest doctor .",
			"skills:update": "{{dlx}} skills@latest update -p -y"
		},
		"tanstack-start": {
			"dev": "vite dev --port 3000",
			"build": "vite build",
			"preview": "vite preview",
			"typecheck": "tsr generate && tsc --noEmit"
		},
		"tanstack-start+runtime-bun+nitro": {
			"dev": "bun --bun vite dev --port 3000",
			"build": "bun --bun vite build",
			"preview": "bun --bun vite preview"
		},
		"next": {
			"dev": "next dev",
			"build": "next build",
			"start": "next start",
			"typecheck": "next typegen && tsc --noEmit"
		},
		"next+runtime-bun+!cloudflare": {
			"dev": "bun --bun next dev",
			"build": "bun --bun next build",
			"start": "bun --bun next start"
		},
		"runtime-bun": { "test": "bun --bun vitest run" },
		"runtime-node": { "test": "vitest run" },
		"tanstack-start+cloudflare": { "deploy": "{{run}} build && wrangler deploy", "cf-typegen": "wrangler types" },
		"db+runtime-bun": { "db:generate": "bun --bun drizzle-kit generate" },
		"db+runtime-node": { "db:generate": "drizzle-kit generate" },
		"postgres+runtime-bun": {
			"db:migrate": "bun --bun drizzle-kit migrate",
			"db:studio": "bun --bun drizzle-kit studio"
		},
		"postgres+runtime-node": { "db:migrate": "drizzle-kit migrate", "db:studio": "drizzle-kit studio" },
		"d1": { "db:migrate": "wrangler d1 migrations apply DB --local" },
		"auth": {
			"auth:generate": "{{dlx}} auth@latest generate --config better-auth.config.ts --adapter drizzle --dialect {{authDialect}} --output src/server/auth/better-auth/tables.ts --yes"
		},
		"email": { "email:dev": "email dev --dir src/server/email/templates --port 3001" },
		"tanstack-start+node+runtime-bun": { "start": "bun .output/server/index.mjs" },
		"tanstack-start+node+runtime-node": { "start": "node .output/server/index.mjs" },
		"next+cloudflare": {
			"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
			"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
			"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
		}
	},
	"removeScripts": ["generate-routes", "format"],
	"scriptsAddOnly": ["test", "prepare"],
	"claudeSettings": {
		"core": {
			"allow": [
				"Bash({{run}} dev)",
				"Bash({{run}} build)",
				"Bash({{run}} check)",
				"Bash({{run}} typecheck)",
				"Bash({{run}} lint)",
				"Bash({{run}} fix)",
				"Bash({{run}} unused)",
				"Bash({{run}} test:*)",
				"Bash({{run}} scope:*)",
				"Bash({{run}} log:*)",
				"Bash({{run}} task:new:*)",
				"Bash({{run}} new:feature:*)",
				"Bash({{run}} docs:sync)",
				"Bash({{run}} docs:get:*)",
				"Bash({{run}} design:md list:*)",
				"Bash({{run}} release:check)",
				"Bash(git status:*)",
				"Bash(git diff:*)",
				"Bash(git log:*)",
				"Bash(rg:*)"
			],
			"ask": [
				"Bash(git commit:*)",
				"Bash(git push:*)",
				"Bash(git merge:*)",
				"Bash(git rebase:*)",
				"Bash(gh pr merge:*)",
				"Bash({{add}}:*)",
				"Bash({{pm}} remove:*)",
				"Bash({{pm}} update:*)",
				"Bash({{run}} deploy:*)",
				"Bash({{run}} skills:update)"
			],
			"deny": [
				"Read(./.env)",
				"Read(./.env.local)",
				"Read(./.env.development)",
				"Read(./.env.production)",
				"Read(./.dev.vars)",
				"Read(./.dev.vars.local)",
				"Edit(./.env)",
				"Edit(./.env.local)",
				"Edit(./.dev.vars)",
				"Read(./{{lockfile}})",
				"Edit(./{{lockfile}})",
				"Bash(rm -rf:*)",
				"Bash(git reset --hard:*)",
				"Bash(git clean:*)",
				"Bash(git push --force:*)",
				"Bash(git push -f:*)",
				"Bash(git push --force-with-lease:*)",
				"Bash(git checkout -- .:*)"
			]
		},
		"cloudflare": {
			"ask": [
				"Bash(wrangler deploy:*)",
				"Bash({{exec}} wrangler deploy:*)",
				"Bash(wrangler rollback:*)",
				"Bash({{exec}} wrangler rollback:*)",
				"Bash(wrangler secret:*)",
				"Bash({{exec}} wrangler secret:*)",
				"Bash(wrangler r2:*)",
				"Bash({{exec}} wrangler r2:*)",
				"Bash(wrangler kv:*)",
				"Bash({{exec}} wrangler kv:*)",
				"Bash(wrangler d1:*)",
				"Bash({{exec}} wrangler d1:*)",
				"Bash(wrangler hyperdrive:*)",
				"Bash({{exec}} wrangler hyperdrive:*)"
			]
		},
		"db": {
			"allow": ["Bash({{run}} db:generate)"],
			"ask": [
				"Bash({{run}} db:migrate:*)",
				"Bash({{exec}} drizzle-kit migrate:*)",
				"Bash({{exec}} drizzle-kit push:*)"
			]
		},
		"auth": { "allow": ["Bash({{run}} auth:generate)"] },
		"email": { "allow": ["Bash({{run}} email:dev)"] },
		"tanstack-start": { "deny": ["Read(./src/routeTree.gen.ts)", "Edit(./src/routeTree.gen.ts)"] }
	},
	"gitignore": [
		"# create-agent-ready-app",
		".env",
		".env.*",
		"!.env.example",
		".dev.vars",
		".dev.vars.*",
		".claude/settings.local.json",
		"docs/official/cache/",
		".agents/create.log",
		".open-next"
	],
	"gitattributes": [
		"# create-agent-ready-app",
		"* text=auto eol=lf",
		"CHANGELOG.md merge=union",
		"{{lockfile}} linguist-generated=true",
		"src/routeTree.gen.ts linguist-generated=true",
		"docs/official/INDEX.md linguist-generated=true"
	],
	"routeTreeFileFooter": "import type { getRouter } from './router.tsx'\nimport type { createStart } from '@tanstack/react-start'\ndeclare module '@tanstack/react-start' {\n  interface Register {\n    ssr: true\n    router: Awaited<ReturnType<typeof getRouter>>\n  }\n}",
	"tsconfigFlags": [
		"strict",
		"noUnusedLocals",
		"noUnusedParameters",
		"noFallthroughCasesInSwitch",
		"allowImportingTsExtensions"
	],
	"legacyAgentFiles": ["GEMINI.md", ".cursorrules", ".windsurfrules", ".github/copilot-instructions.md"],
	"budgets": {
		"AGENTS.md": 90,
		"PROJECT.md": 80,
		"docs/DEPLOYMENT.md": 50,
		"docs/RUNBOOK.md": 40,
		"kitSkill": 130,
		"taskFile": 15
	}
}
