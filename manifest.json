{
	"$comment": "Everything create-agent-ready-app puts into a project. Keys in files/scripts/packages/claudeSettings/shadcn.components are template flags (see src/kit-config.ts renderFlags); 'a+b' means both. File rules: first match wins; unmatched files are project-owned; 'block' files hold the kit's rules between its own markers and keep everything else. Package lists hold names only: versions are resolved at create time. skillPacks install community skills from their upstream repos with the skills CLI, so every project gets that day's version.",
	"verifiedOn": "2026-11-01",
	"frameworks": {
		"tanstack-start": {
			"label": "TanStack Start",
			"hint": "Vite, type-safe routing, server functions",
			"scaffold": [
				"@tanstack/cli@latest",
				"create",
				"{name}",
				"--target-dir",
				"{dir}",
				"--package-manager",
				"{pm}",
				"--deployment",
				"{deployment}",
				"--toolchain",
				"biome",
				"--no-examples",
				"--no-git",
				"--no-install",
				"--no-intent",
				"-y"
			],
			"expectFiles": [
				"package.json",
				"vite.config.ts",
				"tsconfig.json",
				"src/router.tsx",
				"src/routes/__root.tsx",
				"src/styles.css"
			],
			"deployments": { "node": "nitro", "vercel": "vercel", "cloudflare": "cloudflare" }
		},
		"next": {
			"label": "Next.js",
			"hint": "App Router, Server Components, Cache Components",
			"scaffold": [
				"create-next-app@latest",
				"{dir}",
				"--ts",
				"--tailwind",
				"--biome",
				"--app",
				"--src-dir",
				"--import-alias",
				"#/*",
				"--agents-md",
				"--no-agent-feedback",
				"--use-{pm}",
				"--skip-install",
				"--disable-git",
				"--yes"
			],
			"expectFiles": [
				"package.json",
				"next.config.ts",
				"tsconfig.json",
				"src/app/layout.tsx",
				"src/app/page.tsx",
				"src/app/globals.css",
				"AGENTS.md"
			]
		}
	},
	"runtimes": {
		"bun": { "label": "Bun", "hint": "scripts run with bun --bun", "pms": ["bun"] },
		"node": { "label": "Node.js", "hint": "22.20 or newer", "pms": ["pnpm", "npm"] }
	},
	"deploys": {
		"node": { "label": "Node server", "hint": "Docker, a VPS, Railway, Render" },
		"vercel": { "label": "Vercel", "hint": "zero config" },
		"cloudflare": { "label": "Cloudflare Workers", "hint": "edge; Hyperdrive or D1" }
	},
	"addOns": {
		"shadcn": { "label": "shadcn/ui", "hint": "components, theme, toasts" },
		"query": { "label": "TanStack Query", "hint": "data fetching, caching, mutations" },
		"form": { "label": "TanStack Form", "hint": "forms with Zod validation" },
		"hono": { "label": "Hono", "hint": "/api/* with a typed RPC client" },
		"db": { "label": "Database", "hint": "Drizzle ORM" },
		"auth": {
			"label": "Better Auth",
			"hint": "email + password sign-in, sessions, protected pages",
			"requires": ["db"]
		},
		"email": { "label": "Email", "hint": "React Email templates" },
		"seo": { "label": "SEO / AEO", "hint": "robots.txt, sitemap.xml, llms.txt, JSON-LD" }
	},
	"databases": {
		"postgres": {
			"label": "Postgres (Drizzle)",
			"hint": "Docker locally; Supabase, Neon or any host in production"
		},
		"d1": { "label": "Cloudflare D1 (Drizzle)", "hint": "SQLite at the edge", "deploys": ["cloudflare"] }
	},
	"emailProviders": { "resend": { "label": "Resend" }, "zeptomail": { "label": "ZeptoMail" } },
	"addOnGroups": [
		{ "label": "UI", "items": ["shadcn"] },
		{ "label": "Data", "items": ["query"] },
		{ "label": "Forms", "items": ["form"] },
		{ "label": "API", "items": ["hono"] },
		{ "label": "Database", "pickOne": true, "items": ["postgres", "d1"] },
		{ "label": "Authentication", "items": ["auth"] },
		{ "label": "Email", "pickOne": true, "items": ["resend", "zeptomail"] },
		{ "label": "Deployment", "pickOne": true, "items": ["node", "vercel", "cloudflare"] },
		{ "label": "SEO", "items": ["seo"] },
		{ "label": "Agent skills", "items": ["marketing", "security-review", "payments", "next-workflows"] }
	],
	"presets": {
		"static": ["seo", "shadcn"],
		"app": ["seo", "shadcn", "query", "form", "hono", "postgres", "auth"],
		"full": ["seo", "shadcn", "query", "form", "hono", "postgres", "auth", "resend"]
	},
	"packages": {
		"core": { "dev": ["knip", "vitest", "@playwright/cli"] },
		"query": { "deps": ["@tanstack/react-query", "@tanstack/react-query-devtools"] },
		"form": { "deps": ["@tanstack/react-form", "zod", "lucide-react"] },
		"hono": { "deps": ["hono", "@hono/zod-validator", "zod"] },
		"db": { "deps": ["drizzle-orm", "zod"], "dev": ["drizzle-kit"] },
		"postgres": { "deps": ["pg"], "dev": ["@types/pg", "@electric-sql/pglite"] },
		"d1": { "dev": ["sql.js", "@types/sql.js"] },
		"auth": { "deps": ["better-auth", "zod"] },
		"email": { "deps": ["react-email", "zod"], "dev": ["@react-email/ui"] },
		"resend": { "deps": ["resend"] },
		"tanstack-start": {
			"dev": ["vite-plugin-svgr", "@svgr/plugin-svgo", "@svgr/plugin-jsx", "@tanstack/intent", "@tanstack/router-cli"]
		},
		"query+tanstack-start": { "deps": ["@tanstack/react-router-ssr-query"] },
		"vercel+postgres": { "deps": ["@vercel/functions"] },
		"tanstack-start+vercel+auth+email": { "deps": ["@vercel/functions"] },
		"next": { "dev": ["@svgr/webpack", "@vitejs/plugin-react"] },
		"next+hono": { "deps": ["@hono/vercel"] },
		"next+cloudflare": { "deps": ["@opennextjs/cloudflare"], "dev": ["wrangler"] }
	},
	"verified": {
		"@tanstack/react-start": "1",
		"@tanstack/react-router": "1",
		"@tanstack/router-cli": "1",
