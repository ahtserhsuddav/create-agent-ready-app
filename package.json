{
	"name": "create-agent-ready-app",
	"version": "0.1.0",
	"description": "Create a TanStack Start or Next.js app that coding agents are ready to work in: only the add-ons you pick, official agent skills from the stack's makers (Vercel, Better Auth, Cloudflare, GitHub, Resend, Stripe, Supabase…) kept up to date, and a design workflow built on your references, awesome-design-md and taste-skill.",
	"type": "module",
	"license": "MIT",
	"author": "uddav-shr (https://github.com/ahtserhsuddav)",
	"homepage": "https://github.com/ahtserhsuddav/create-agent-ready-app#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ahtserhsuddav/create-agent-ready-app.git"
	},
	"bugs": {
		"url": "https://github.com/ahtserhsuddav/create-agent-ready-app/issues"
	},
	"keywords": [
		"create",
		"create-app",
		"cli",
		"scaffold",
		"starter",
		"starter-kit",
		"boilerplate",
		"template",
		"tanstack",
		"tanstack-start",
		"react",
		"vite",
		"typescript",
		"hono",
		"drizzle",
		"better-auth",
		"shadcn",
		"tailwindcss",
		"cloudflare-workers",
		"bun",
		"agents-md",
		"ai-agents",
		"claude-code",
		"codex",
		"cursor",
		"nextjs",
		"next",
		"agent-skills",
		"skills",
		"design-md",
		"vercel"
	],
	"bin": {
		"create-agent-ready-app": "dist/cli.js"
	},
	"files": ["dist", "template", "manifest.json", "README.md", "LICENSE"],
	"engines": {
		"node": ">=22.20"
	},
	"scripts": {
		"build": "bun build cli.ts --target node --outfile dist/cli.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint",
		"test": "bun test tests/unit",
		"verify:package": "bun scripts/verify-package.ts",
		"verify:skills": "bun scripts/verify-skills.ts",
		"verify:docs": "bun scripts/verify-docs.ts",
		"verify:build": "bun scripts/verify-build.ts",
		"check-links": "bun scripts/check-catalog-links.ts",
		"prepublishOnly": "bun run typecheck && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@clack/prompts": "^1.8.1",
		"@types/bun": "^1.3.4",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"yaml": "^2.9.1"
	}
}
