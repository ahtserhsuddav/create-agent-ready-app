{
	"$comment": "Which official doc pages each template follows. `bun run verify:docs` re-fetches every page and lists the templates whose docs changed since they were last checked; after re-checking a template, `bun run verify:docs --accept` records the new page hashes. Template paths are labels: app/ is template/app (shared by both frameworks), next/ and tanstack-start/ are template/frameworks/<name>, agent/ is template/agent, src/ is the CLI.",
	"sources": [
		{
			"templates": [
				"(create pipeline) src/create/scaffold-base.ts"
			],
			"docs": [
				"https://tanstack.com/cli/latest/docs/cli-reference",
				"https://developers.cloudflare.com/workers/wrangler/configuration/"
			]
		},
		{
			"templates": [
				"vite.config.ts",
				"vitest.config.ts"
			],
			"docs": [
				"https://tanstack.com/start/latest/docs/framework/react/guide/hosting",
				"https://developers.cloudflare.com/workers/framework-guides/web-apps/tanstack-start/",
				"https://react-svgr.com/docs/options/"
			]
		},
		{
			"templates": [
				"src/router.tsx",
				"src/routes/__root.tsx",
				"src/shared/lib/tanstack/query-client.ts"
			],
			"docs": [
				"https://tanstack.com/router/latest/docs/integrations/query"
			]
		},
		{
			"templates": [
				"src/shared/lib/tanstack/form-context.ts",
				"src/shared/lib/tanstack/form-hook.ts",
				"src/shared/components/form/*",
				"src/features/auth/components/*-form.tsx"
			],
			"docs": [
				"https://tanstack.com/form/latest/docs/framework/react/guides/form-composition",
				"https://tanstack.com/form/latest/docs/framework/react/guides/validation"
			]
		},
		{
			"templates": [
				"src/server/api/hono/app.ts",
				"src/shared/api/hono/client.ts",
				"scripts/agent/templates/feature/hooks/use-__name__.ts.tpl"
			],
			"docs": [
				"https://hono.dev/docs/guides/rpc"
			]
		},
		{
			"templates": [
				"src/server/api/hono/middleware.ts",
				"src/server/api/hono/error-handler.ts",
				"scripts/agent/templates/feature/server/routes.ts.tpl"
			],
			"docs": [
				"https://hono.dev/docs/helpers/factory",
				"https://hono.dev/docs/api/exception",
				"https://www.better-auth.com/docs/integrations/hono"
			]
		},
		{
			"templates": [
				"src/server/auth/better-auth/*",
				"src/routes/api/auth/$.ts",
				"src/features/auth/functions.ts",
				"src/routes/_private/route.tsx"
			],
			"docs": [
				"https://www.better-auth.com/docs/integrations/tanstack",
				"https://www.better-auth.com/docs/adapters/drizzle",
				"https://www.better-auth.com/docs/plugins/email-otp",
				"https://www.better-auth.com/docs/concepts/cookies"
			]
		},
		{
			"templates": [
				"src/server/db/drizzle/client.ts",
				"src/server/db/drizzle/test-client.ts",
				"drizzle.config.ts"
			],
			"docs": [
				"https://orm.drizzle.team/docs/get-started-postgresql",
				"https://developers.cloudflare.com/hyperdrive/examples/connect-to-postgres/postgres-drivers-and-libraries/drizzle-orm/",
				"https://orm.drizzle.team/docs/connect-cloudflare-d1",
				"https://orm.drizzle.team/docs/drizzle-config-file"
			]
		},
		{
			"templates": [
				"src/server/db/drizzle/middleware.ts",
				"src/server/auth/better-auth/middleware.ts",
				"scripts/agent/templates/feature/functions.ts.tpl"
			],
			"docs": [
				"https://tanstack.com/start/latest/docs/framework/react/guide/middleware",
				"https://tanstack.com/start/latest/docs/framework/react/guide/server-functions"
			]
		},
		{
			"templates": [
				"src/server/config/env.ts"
			],
			"docs": [
				"https://tanstack.com/start/latest/docs/framework/react/guide/environment-variables"
			]
		},
		{
			"templates": [
				"src/server/email/templates/*",
				"src/server/email/resend/send.ts",
				"src/server/email/zeptomail/send.ts"
			],
			"docs": [
				"https://react.email/docs/introduction",
				"https://resend.com/docs/send-with-nodejs",
				"https://www.zoho.com/zeptomail/help/api/email-sending.html"
			]
		},
		{
			"templates": [
				"components.json",
				"(create pipeline) src/create/official-clis.ts"
			],
			"docs": [
				"https://ui.shadcn.com/docs/cli",
				"https://ui.shadcn.com/docs/components-json"
			]
		},
		{
			"templates": [
				"biome.json",
				".agents/biome.kit.json",
				"knip.json"
			],
			"docs": [
				"https://biomejs.dev/reference/configuration/",
				"https://knip.dev/reference/configuration"
			]
		},
		{
			"templates": [
				"next/next.config.ts",
				"next/src/app/**",
				"agent/AGENTS.md (Next.js block)"
			],
			"docs": [
				"https://nextjs.org/docs/app/guides/ai-agents.md",
				"https://nextjs.org/docs/app/api-reference/cli/create-next-app.md",
				"https://nextjs.org/docs/app/api-reference/config/next-config-js/turbopack.md"
			]
		},
		{
			"templates": [
				"next/src/app/api/[[...route]]/route.ts"
			],
			"docs": [
				"https://hono.dev/docs/getting-started/nextjs"
			]
		},
		{
			"templates": [
				"next/src/app/api/auth/[...all]/route.ts",
				"next/src/server/auth/better-auth/session.ts",
				"app/src/server/auth/better-auth/setup.ts (nextCookies)"
			],
			"docs": [
				"https://www.better-auth.com/docs/integrations/next"
			]
		},
		{
			"templates": [
				"app/src/server/auth/better-auth/setup.ts (email and password)",
				"*/src/features/auth/**"
			],
			"docs": [
				"https://www.better-auth.com/docs/authentication/email-password.md"
			]
		},
		{
			"templates": [
				"next/wrangler.jsonc",
				"next/open-next.config.ts",
				"manifest scripts next+cloudflare"
			],
			"docs": [
				"https://opennext.js.org/cloudflare/get-started"
			]
		},
		{
			"templates": [
				"next/src/shared/lib/tanstack/query-provider.tsx"
			],
			"docs": [
				"https://tanstack.com/query/latest/docs/framework/react/guides/advanced-ssr"
			]
		},
		{
			"templates": [
				"app/src/server/db/drizzle/client.ts (attachDatabasePool)",
				"app/src/server/auth/better-auth/setup.ts (waitUntil)"
			],
			"docs": [
				"https://vercel.com/docs/functions/functions-api-reference/vercel-functions-package.md"
			]
		},
		{
			"templates": [
				"(create pipeline) src/create/official-clis.ts (TanStack Intent)",
				"tanstack-start package.json intent.skills"
			],
			"docs": [
				"https://tanstack.com/intent/latest/docs/getting-started/quick-start-consumers"
			]
		},
		{
			"templates": [
				"src/skills.ts",
				"agent/.github/workflows/skills-update.yml"
			],
			"docs": [
				"https://raw.githubusercontent.com/vercel-labs/skills/main/docs/commands.md"
			]
		}
	],
