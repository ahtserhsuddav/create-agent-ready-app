# Local development only. Copy to .env and fill it in: .env is git-ignored, and agents never read or write it.
# Production values are set where docs/DEPLOYMENT.md says.
{{#postgres}}

# Postgres. `docker compose up -d` starts a local one that matches this URL.
DATABASE_URL=postgres://app:app@localhost:5432/app
{{#cloudflare}}
# `{{run}} dev` reaches it through Hyperdrive's localConnectionString in wrangler.jsonc. A different local database?
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://…
{{/cloudflare}}
{{/postgres}}
{{#auth}}

# Better Auth: a random secret of 32+ characters (`{{dlx}} auth@latest secret` makes one) and this site's URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
{{/auth}}
{{#email}}

# Email: the sender address must be on a domain verified with your email provider.
EMAIL_FROM=hello@example.com
EMAIL_FROM_NAME={{name}}
{{/email}}
{{#resend}}
# Leave empty in development to print emails to the console instead of sending them.
RESEND_API_KEY=
{{/resend}}
{{#zeptomail}}
# Leave empty in development to print emails to the console instead of sending them.
ZEPTOMAIL_TOKEN=
{{/zeptomail}}
