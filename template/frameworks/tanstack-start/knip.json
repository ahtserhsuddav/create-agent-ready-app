{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
{{#shadcn}}
    "src/shared/components/ui/*.tsx",
{{/shadcn}}
{{#hono}}
    "src/shared/api/hono/client.ts",
    "src/server/api/hono/middleware.ts",
{{/hono}}
{{#auth}}
    "src/server/auth/better-auth/middleware.ts",
{{/auth}}
{{#db}}
    "src/server/db/drizzle/middleware.ts",
    "src/server/db/drizzle/test-client.ts",
{{/db}}
{{#auth}}
    "better-auth.config.ts",
{{/auth}}
{{#form}}
    "src/shared/lib/tanstack/form-hook.ts",
{{/form}}
{{#email}}
    "src/server/email/*/send.ts",
    "src/server/email/templates/*.tsx",
{{/email}}
    "src/routes/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
  "ignoreDependencies": [
    "@svgr/plugin-svgo",
    "@svgr/plugin-jsx",
    "@playwright/cli",
    "@tanstack/intent"
  ]
}
